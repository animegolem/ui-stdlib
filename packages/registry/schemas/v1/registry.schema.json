{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "urn:ui-stdlib:schema:registry:v1",
  "title": "ui-stdlib registry manifest v1",
  "allOf": [
    { "$ref": "urn:ui-stdlib:schema:vendor:shadcn:2026-10-10:registry" },
    {
      "type": "object",
      "properties": {
        "$schema": { "const": "urn:ui-stdlib:schema:registry:v1" },
        "schemaVersion": { "const": 1 },
        "name": { "type": "string", "minLength": 1 },
        "homepage": { "type": "string", "pattern": "^https://" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "urn:ui-stdlib:schema:item:v1" }
        }
      },
      "required": ["$schema", "schemaVersion", "name", "homepage", "items"],
      "not": { "required": ["include"] }
    }
  ]
}
